rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email.lower() == 'andradenaty23@gmail.com')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Coleção usuarios
    match /usuarios/{uid} {
      allow read: if true; // Perfis públicos de profissionais e clientes para exibição no catálogo
      allow create: if isOwner(uid) && 
        (incoming().tipo != 'admin' || isAdmin());
      allow update: if (isOwner(uid) && (
        !('tipo' in incoming()) || incoming().tipo != 'admin' || isAdmin()
      )) || (
        isSignedIn() && 
        incoming().diff(existing()).affectedKeys().hasOnly(['avaliacaoMedia', 'totalAvaliacoes', 'atualizadoEm'])
      ) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // 2. Coleção categorias
    match /categorias/{categoriaId} {
      allow read: if true; // Categorias são públicas para clientes e profissionais
      allow write: if isSignedIn(); // Permite criar/inicializar categorias
    }

    // 3. Coleção servicos
    match /servicos/{servicoId} {
      allow read: if true; // Serviços disponíveis são pesquisáveis
      allow create: if isSignedIn() && (incoming().profissionalId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (existing().profissionalId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().profissionalId == request.auth.uid || isAdmin());
    }

    // 4. Coleção solicitacoes / agendamentos
    match /solicitacoes/{solicitacaoId} {
      allow read: if isSignedIn() && (
        resource.data.clienteId == request.auth.uid ||
        resource.data.profissionalId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().clienteId == request.auth.uid ||
        incoming().profissionalId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        existing().clienteId == request.auth.uid ||
        existing().profissionalId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        existing().clienteId == request.auth.uid ||
        existing().profissionalId == request.auth.uid ||
        isAdmin()
      );
    }

    // 5. Coleção avaliacoes
    match /avaliacoes/{avaliacaoId} {
      allow read: if true; // Avaliações são públicas para reputação dos profissionais
      allow create: if isSignedIn() && 
        (incoming().clienteId == request.auth.uid || isAdmin()) &&
        incoming().nota >= 1 && incoming().nota <= 5;
      allow update: if isSignedIn() && (existing().clienteId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().clienteId == request.auth.uid || isAdmin());
    }

    // 6. Coleção favoritos
    match /favoritos/{favoritoId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().usuarioId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
    }

    // 7. Coleção notificacoes
    match /notificacoes/{notificacaoId} {
      allow read: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow create: if isSignedIn(); // Usuários autenticados criam notificações em ações
      allow update: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
    }
  }
}
